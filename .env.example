# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server-Only Configuration (NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Salt used to hash sender IP & user-agent for privacy-preserving blocking
SENDER_HASH_SALT="lconfess_super_secret_salt_change_this_in_production"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Turnstile Bot Protection (Optional / Adaptive)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x00000000000000000000000000000000AA"
