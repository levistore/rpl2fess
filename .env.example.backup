# =========================================================
# RPLTwoFess Environment Variables Template (Backup)
# NOTE: DO NOT commit actual secrets here. Fill in values for local/deployment.
# =========================================================

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only Admin Configuration (Keep Private)
SUPABASE_SERVICE_ROLE_KEY=

# Privacy & Security Salt (IP & User-Agent Hashing)
SENDER_HASH_SALT=

# Application Base URL
NEXT_PUBLIC_APP_URL=

# Cloudflare Turnstile Bot Protection (Optional / Adaptive)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Web Push Notification VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
